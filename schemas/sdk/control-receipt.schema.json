{
  "$defs": {
    "ControlCommandKind": {
      "description": "Explicit user intents supported by the invocation control plane.",
      "enum": [
        "steer",
        "interrupt_current",
        "cancel_queued",
        "stop_and_clear",
        "reorder"
      ],
      "title": "ControlCommandKind",
      "type": "string"
    },
    "ControlCommandStatus": {
      "description": "Durable acknowledgement state for one control command.",
      "enum": [
        "accepted",
        "applied",
        "rejected",
        "conflict"
      ],
      "title": "ControlCommandStatus",
      "type": "string"
    },
    "SteerSafePoint": {
      "description": "Runtime boundaries where a steer may change future execution.",
      "enum": [
        "before_reasoning",
        "after_reasoning",
        "before_tool_batch",
        "after_tool_batch"
      ],
      "title": "SteerSafePoint",
      "type": "string"
    }
  },
  "$id": "https://schemas.qwenpaw.dev/sdk/control-receipt.v1.json",
  "additionalProperties": false,
  "description": "Authoritative acknowledgement for submission or control mutation.",
  "properties": {
    "agent_id": {
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "applied_at_safe_point": {
      "anyOf": [
        {
          "$ref": "#/$defs/SteerSafePoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "chat_id": {
      "description": "Owning ChatSpec.id",
      "minLength": 1,
      "title": "Chat Id",
      "type": "string"
    },
    "command_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command Id"
    },
    "detail": {
      "default": "",
      "title": "Detail",
      "type": "string"
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/ControlCommandKind"
        },
        {
          "const": "enqueue",
          "type": "string"
        }
      ],
      "title": "Kind"
    },
    "receipt_id": {
      "format": "uuid",
      "title": "Receipt Id",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema": {
      "const": "qwenpaw.kernel-model.v1",
      "default": "qwenpaw.kernel-model.v1",
      "title": "Schema",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ControlCommandStatus"
    },
    "submission_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Id"
    }
  },
  "required": [
    "schema",
    "chat_id",
    "receipt_id",
    "command_id",
    "submission_id",
    "kind",
    "status",
    "agent_id",
    "revision",
    "detail",
    "applied_at_safe_point",
    "recorded_at"
  ],
  "title": "ControlReceipt",
  "type": "object"
}
